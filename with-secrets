#!/usr/bin/env bash
# Managed by pubkit 0.14.2: `pubkit sync` rewrites this file, and
# `pubkit sync --check` fails when it differs. This repository's settings are
# in with-secrets.json, which is its own.
#
# Run one command with this repository's secrets in its environment:
#
#   ./with-secrets terraform plan
#   ./with-secrets scripts/some-setup.sh
#
# The secrets are read from a Bitwarden Secrets Manager project with the bws
# CLI, using a read-only machine account's access token: BWS_ACCESS_TOKEN if
# set, else the line BWS_ACCESS_TOKEN=... in the repository's .env, which git
# must ignore. They exist only in this command's process and what it starts:
# nothing is written to disk, and the calling shell never holds them.
#
# with-secrets.json:
#
#   project               the project's name or id
#   terraform.dir         where the Terraform files are ("." for here)
#   terraform.secrets     how secrets reach Terraform:
#     "declared"          a secret whose name is a declared variable's in
#                         upper case (HCLOUD_TOKEN for "hcloud_token") goes
#                         as TF_VAR_hcloud_token, and under no other name
#     "map"               the names terraform.names_from lists (a locals
#                         block of "name" = "description" lines) go as two
#                         maps, TF_VAR_secret_values (declare it ephemeral,
#                         so values never reach plan or state) and
#                         TF_VAR_secret_revisions (each secret's last-change
#                         time, so changing a key makes a new version)
#   aliases               files (paths from the repository root) that also
#                         export a secret under another name, for a tool that
#                         reads a fixed one; keep each next to the code that
#                         needs it. Each is {"aliases": {"NAME": "secret"}}:
#                         the secret named "secret" is also exported as NAME
#                         (a "comment" key is ignored). A missing secret is
#                         reported and skipped.
#
# Every other secret is exported under its name in upper case, with "-" as
# "_": linear-api-key as LINEAR_API_KEY.
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
config="$root/with-secrets.json"

if [ $# -eq 0 ]; then
  echo "usage: ./with-secrets COMMAND [ARGS...]" >&2
  exit 2
fi
for tool in bws jq; do
  if ! command -v "$tool" >/dev/null; then
    echo "$tool is not installed: bws from https://github.com/bitwarden/sdk-sm/releases (or cargo install bws --locked), jq from your package manager." >&2
    exit 1
  fi
done
if [ ! -f "$config" ]; then
  echo "No $config: it names the Bitwarden project to read (see this script's header)." >&2
  exit 1
fi
project=$(jq -r '.project // empty' "$config")
tf_dir=$(jq -r '.terraform.dir // empty' "$config")
tf_mode=$(jq -r '.terraform.secrets // empty' "$config")
tf_names_from=$(jq -r '.terraform.names_from // empty' "$config")
alias_files=$(jq -r '.aliases // [] | .[]' "$config")
if [ -z "$project" ]; then
  echo "$config names no project." >&2
  exit 1
fi
case "$tf_mode" in
  "" | declared) ;;
  map)
    if [ -z "$tf_names_from" ] || [ ! -f "$root/$tf_names_from" ]; then
      echo "$config: terraform.secrets \"map\" needs terraform.names_from, a file listing the names." >&2
      exit 1
    fi
    ;;
  *)
    echo "$config: terraform.secrets is \"declared\" or \"map\", not \"$tf_mode\"." >&2
    exit 1
    ;;
esac

aliases="{}"
while IFS= read -r file; do
  [ -n "$file" ] || continue
  if [ ! -f "$root/$file" ]; then
    echo "$config: the aliases file $file does not exist." >&2
    exit 1
  fi
  if ! aliases=$(jq -c --argjson a "$aliases" '$a + (.aliases // {})' "$root/$file"); then
    echo "$file is not JSON of the form {\"aliases\": {\"NAME\": \"secret\"}}." >&2
    exit 1
  fi
done <<<"$alias_files"
for alias in $(jq -r 'keys[]' <<<"$aliases"); do
  if ! [[ $alias =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    echo "alias '$alias': not usable as an environment variable name (upper case, digits and _)." >&2
    exit 1
  fi
done

# .env holds BWS_ACCESS_TOKEN=..., with or without quotes or "export".
if [ -z "${BWS_ACCESS_TOKEN:-}" ] && [ -f "$root/.env" ]; then
  BWS_ACCESS_TOKEN=$(sed -nE 's/^(export[[:space:]]+)?BWS_ACCESS_TOKEN[[:space:]]*=[[:space:]]*//p' "$root/.env" \
    | head -n 1 | tr -d '"'"'"'\r')
fi
if [ -z "${BWS_ACCESS_TOKEN:-}" ]; then
  echo "No access token: set BWS_ACCESS_TOKEN, or put BWS_ACCESS_TOKEN=... in $root/.env." >&2
  exit 1
fi
export BWS_ACCESS_TOKEN

# A token without access to a project lists no secrets rather than failing,
# so check it can see the project first.
if ! projects=$(bws project list --output json); then
  echo "bws could not list projects with this access token." >&2
  exit 1
fi
project_id=$(jq -r --arg p "$project" '.[] | select(.id == $p or .name == $p) | .id' <<<"$projects" | head -n 1)
if [ -z "$project_id" ]; then
  echo "This access token's machine account can't see the project $project." >&2
  echo "It sees: $(jq -r '[.[].name] | join(", ")' <<<"$projects")." >&2
  echo "Give the machine account read access to that project in Bitwarden Secrets Manager." >&2
  exit 1
fi
if ! secrets=$(bws secret list "$project_id" --output json); then
  echo "bws could not list the secrets of project $project." >&2
  exit 1
fi

declared=""
if [ "$tf_mode" = declared ]; then
  declared=$(cat "$root/${tf_dir:-.}"/*.tf 2>/dev/null | sed -nE 's/^variable "([a-z0-9_]+)".*/\1/p')
fi

names=()
count=$(jq 'length' <<<"$secrets")
for ((i = 0; i < count; i++)); do
  key=$(jq -r --argjson i "$i" '.[$i].key' <<<"$secrets")
  value=$(jq -r --argjson i "$i" '.[$i].value' <<<"$secrets")
  name=$(tr '[:lower:]-' '[:upper:]_' <<<"$key")
  if [ -z "$value" ] || ! [[ $name =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    echo "skipping secret '$key': empty, or not usable as an environment variable name" >&2
    continue
  fi
  lower=$(tr '[:upper:]' '[:lower:]' <<<"$name")
  if [ -n "$declared" ] && grep -qx "$lower" <<<"$declared"; then
    name="TF_VAR_$lower"
  fi
  export "$name=$value"
  names+=("$name")
done

for alias in $(jq -r 'keys[]' <<<"$aliases"); do
  source=$(jq -r --arg a "$alias" '.[$a]' <<<"$aliases")
  value=$(jq -r --arg k "$source" 'map(select(.key == $k)) | .[0].value // empty' <<<"$secrets")
  if [ -z "$value" ]; then
    echo "alias $alias: no secret '$source' in Bitwarden" >&2
    continue
  fi
  export "$alias=$value"
  names+=("$alias")
done

if [ "$tf_mode" = map ]; then
  wanted=$(sed -n 's/^[[:space:]]*"\([a-z0-9-]*\)"[[:space:]]*=[[:space:]]*"[^"]*",*[[:space:]]*$/\1/p' "$root/$tf_names_from")
  select='($names | split("\n")) as $n | map(select(.key as $k | $n | index($k)) | select(.value != ""))'
  TF_VAR_secret_values=$(jq -c --arg names "$wanted" "$select"' | map({(.key): .value}) | add // {}' <<<"$secrets")
  TF_VAR_secret_revisions=$(jq -c --arg names "$wanted" "$select"' | map({(.key): (.revisionDate | sub("\\.[0-9]+Z$"; "Z") | fromdate)}) | add // {}' <<<"$secrets")
  export TF_VAR_secret_values TF_VAR_secret_revisions
  found=$(jq -r 'keys | join(", ")' <<<"$TF_VAR_secret_revisions")
  missing=$(jq -r --arg names "$wanted" '($names | split("\n")) - keys | join(", ")' <<<"$TF_VAR_secret_revisions")
  echo "To Terraform as TF_VAR_secret_values: ${found:-none}${missing:+; not in Bitwarden: $missing}" >&2
fi

echo "From Bitwarden: ${names[*]:-none}" >&2
exec "$@"
