{
  "kind": "service",
  "bin": "storage",
  "ci": {
    "with": {
      "setup": "npm ci",
      "test": "npm test",
      "shellcheck": "with-secrets mirror/*.sh scripts/*.sh"
    }
  },
  "protect": {
    "checks": [
      "ci / passed",
      "integrations / scan"
    ],
    "tags": false
  },
  "github_app": {
    "id": {
      "from": "sustenaut-storage-mirror-app-id",
      "to": "MIRROR_APP_ID"
    },
    "installation_id": {
      "from": "sustenaut-storage-mirror-installation-id",
      "to": "MIRROR_APP_INSTALLATION_ID"
    },
    "key": {
      "from": "sustenaut-storage-mirror-app-key",
      "to": "MIRROR_APP_KEY"
    }
  }
}
