{
  "name": "sustenaut-storage",
  "version": "0.1.0",
  "description": "storage.sustenaut.eu: photos for the sustenaut.eu sites, in Cloudflare R2.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.js",
    "dev": "wrangler pages dev public --r2 STORAGE",
    "deploy": "wrangler pages deploy public --project-name sustenaut-storage --branch main"
  },
  "dependencies": {
    "@sustenaut/integrations": "github:Sustenaut/integrations#v0.14.1"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
