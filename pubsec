#!/usr/bin/env bash
# Managed by pubkit 0.34.0: `pubkit sync` rewrites this file, and
# `pubkit sync --check` fails when it differs.
#
# Run this repository's pinned pubsec, which holds what pubkit does not: a
# secret's value, a write token, a private key. ./with-secrets runs it, and
# the deploy walk loads its need types.
#
#   ./pubsec run -- terraform plan
#   ./pubsec --version
#
# The release is deploy.providers' pubsec, or the oldest pubkit 0.34.0
# works with where it lists none, or an older one.
# Its wheel is fetched once into the user's cache (from the wheel mirror,
# when pubkit.json names one and GitHub fails) and checked against its
# sha256 on every run, and uvx runs that file; nothing is installed into the
# repository or the system. pubsec runs in the repository's root, where
# with-secrets.json is, from whichever directory this is called.
set -euo pipefail

if ! command -v uvx >/dev/null 2>&1; then
  echo "pubsec: ./pubsec runs pubsec with uv, which is not installed: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 127
fi

cd "$(dirname "$0")"
# A wheel, fetched once into the user's cache, checked against its sha256 on every run.
fetch() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/pubkit/$3/$2" sum
  fetched="$dir/${1##*/}"
  if [ ! -f "$fetched" ]; then
    mkdir -p "$dir"
    curl -fsSL -o "$fetched.part" "$1" \
      || curl -fsSL -o "$fetched.part" "https://storage.sustenaut.eu/wheels/f/$2/${1##*/}" \
      || { rm -f "$fetched.part"; echo "pubkit: could not fetch $1" >&2; exit 1; }
    mv "$fetched.part" "$fetched"
  fi
  if command -v sha256sum >/dev/null 2>&1; then sum=$(sha256sum "$fetched"); else sum=$(shasum -a 256 "$fetched"); fi
  if [ "${sum%% *}" != "$2" ]; then
    rm -f "$fetched"
    echo "pubkit: $1 is not the wheel $4 pins (sha256 $2)" >&2
    exit 1
  fi
}

fetch https://github.com/Sustenaut/pubsec/releases/download/v0.1.2/pubsec-0.1.2-py3-none-any.whl 88a68ffd252b49289ae02d0a9f629f3e0f0832c921cb8ee0f1301f958527de17 providers deploy.providers
exec uvx --from "$fetched" pubsec "$@"
