      "head": {
        "operationId": "headHead",
        "summary": "The hash a named head points at, as its ETag",
        "security": [
          {},
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "responses": {
          "200": {
            "description": "It points somewhere",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The object's etag; for a head, its file's hash"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "put": {
        "operationId": "moveHead",
        "summary": "Move the head to a stored file, if it hasn't moved since",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "The hash it points at now (quoted, bare or weak)"
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string",
              "const": "*"
            },
            "description": "For its first move"
          }
        ],
        "security": [
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "hash"
                ],
                "properties": {
                  "hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Where it points now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadRecord"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The object's etag; for a head, its file's hash"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
