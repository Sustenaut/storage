{
  "openapi": "3.1.0",
  "info": {
    "title": "storage.sustenaut.eu",
    "version": "1",
    "description": "Photos and files for the sites that use it, in an R2 bucket. Each site is a tenant (tenants.json) with its own part of the bucket; src/storage.js's header says what each tenant setting allows. An error is always {\"error\": \"...\"}. The JavaScript and Python clients are generated from this file in Sustenaut/integrations.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "https://storage.sustenaut.eu"
    }
  ],
  "paths": {
    "/{tenant}/p/{id}/{size}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/tenant"
        },
        {
          "$ref": "#/components/parameters/photoId"
        },
        {
          "$ref": "#/components/parameters/size"
        }
      ],
      "get": {
        "operationId": "getPhoto",
        "summary": "A photo, at one width and format",
        "security": [
          {},
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "responses": {
          "200": {
            "description": "The photo, cached for good (a private tenant's never)",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "image/jpeg"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "image/webp"
                }
              }
            },
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The object's etag; for a head, its file's hash"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      },
      "head": {
        "operationId": "headPhoto",
        "summary": "Whether the photo is stored",
        "security": [
          {},
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "responses": {
          "200": {
            "description": "Stored",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "The object's etag; for a head, its file's hash"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/{tenant}/upload": {
      "parameters": [
        {
          "$ref": "#/components/parameters/tenant"
        }
      ],
      "post": {
        "operationId": "uploadPhoto",
        "summary": "Store one photo's sizes, made in the editor",
        "security": [
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "description": "One field per size, named <width>.<jpg|webp>, at most 1600 wide and 3 MB each; at least one JPEG, and a WebP for every JPEG width if any",
                "propertyNames": {
                  "pattern": "^\\d+\\.(jpg|webp)$"
                },
                "additionalProperties": {
                  "type": "string",
                  "contentMediaType": "application/octet-stream"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The photo's description, which the site keeps in its content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Photo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "503": {
