      ],
      "get": {
        "operationId": "list",
        "summary": "A page of a private tenant's files, or of its buffer's folders, in name order",
        "description": "A public tenant is never listed. Listing takes a reader: a principal on the read or write list, or with \"editors\" a GitHub token that may push to the repository.",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "f/ for the tenant's files (a tenant with \"files\"), then part or all of an id, then / and the start of a name; or inbox/, batches/ or rejected/ and folders under it (a tenant with \"inbox\")",
            "examples": {
              "files": {
                "value": "f/"
              },
              "buffer": {
                "value": "inbox/calls/"
              }
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The last page's cursor"
          }
        ],
        "security": [
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "responses": {
          "200": {
            "description": "The page, and the cursor for the next, or null at the end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/_clean": {
      "post": {
        "operationId": "clean",
        "summary": "Delete what each public tenant's site no longer uses, at most once in 20 hours",
        "security": [
          {}
        ],
        "responses": {
          "200": {
            "description": "What was deleted and what was left alone, by tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CleanReport"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidc": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An OpenID Connect token for the audience storage.sustenaut.eu: a GitHub Actions job's, a k3s pod's service-account token, or a Google service account's identity token (src/jwt.js). Its principal must be on the tenant's read, write or delete list"
      },
      "github": {
        "type": "http",
        "scheme": "bearer",
        "description": "A GitHub token that may push to the tenant's repository: a person's, or a GitHub App installation's (ghs_...). Taken by public tenants, and by private ones with \"editors\": true"
      }
    },
    "parameters": {
      "tenant": {
        "name": "tenant",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "description": "A tenant in tenants.json",
        "example": "opportunity"
      },
      "photoId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "description": "The start of the largest JPEG's SHA-256",
        "example": "0123456789abcdef"
      },
      "size": {
        "name": "size",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d+\\.(jpg|webp)$"
        },
        "description": "<width>.<jpg|webp>",
        "example": "960.webp"
      },
      "fileId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "description": "The file's SHA-256",
        "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "fileName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "example": "report.pdf"
      },
      "headName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "example": "board"
      },
      "bufferPath": {
        "name": "path",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]{0,63}/){0,5}[A-Za-z0-9][A-Za-z0-9._-]{0,119}\\.avro$"
        },
        "description": "Up to five folders and an Avro file's name. Its slashes are sent as they are, not escaped",
        "x-slashes": true,
        "example": "calls/2026-11-06/080200-web-0123456789abcdef.avro"
      },
      "batchName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}\\.json$"
        },
        "example": "job-1.json"
      }
    },
    "responses": {
      "400": {
        "description": "The request is wrong: the error says how",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "No token, or one this tenant doesn't take",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "The token's principal may not do this",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "No such tenant, route or stored object",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "412": {
        "description": "The head has moved since, or has never moved and If-None-Match: * wasn't sent",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "413": {
        "description": "Too big for the tenant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "415": {
        "description": "A file type the tenant doesn't take",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "Cleaned recently",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "GitHub didn't answer in time, or can't be reached: try again",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Why, for a person"
          }
        }
      },
      "Photo": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "widths",
          "formats"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "widths": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "webp",
                "jpg"
              ]
            }
          }
        }
      },
      "StoredFile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "type",
          "size",
          "label",
          "subject",
          "kept"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Its path here: /<tenant>/f/<id>/<name>"
          },
          "type": {
            "type": "string",
            "description": "Its Content-Type"
          },
          "size": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "kept": {
            "type": "boolean"
          }
        }
      },
      "HeadRecord": {
        "type": "object",
        "required": [
          "hash",
          "key",
          "time",
          "principal"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "key": {
            "type": "string",
            "description": "The stored file's key"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "principal": {
            "type": "string"
          }
        }
      },
      "HeadLog": {
        "type": "object",
        "required": [
          "name",
          "log"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "log": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "hash",
                "time",
                "principal"
              ],
              "properties": {
                "hash": {
                  "type": "string"
                },
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "principal": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BufferFile": {
        "type": "object",
        "required": [
          "name",
          "size"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Its place in the tenant, such as inbox/calls/..."
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "ListedFile": {
        "type": "object",
        "required": [
          "name",
          "id",
          "url",
          "size",
          "uploaded",
          "metadata"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "uploaded": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "description": "What the upload said of the file; only what it said",
            "properties": {
              "label": {
                "type": "string"
              },
              "kept": {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              },
              "by": {
                "type": "string",
                "description": "Who uploaded: a GitHub login, github-app, or an OpenID Connect principal"
              },
              "for": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            }
          }
        }
      },
      "ListedBufferFile": {
        "type": "object",
        "required": [
          "name",
          "size",
          "uploaded"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "uploaded": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Listing": {
        "type": "object",
        "required": [
          "files",
          "cursor"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ListedFile"
                },
                {
                  "$ref": "#/components/schemas/ListedBufferFile"
                }
              ]
            },
            "description": "ListedFile for prefix f/, ListedBufferFile for a buffer's folders"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CleanReport": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "deleted": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "skipped": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
