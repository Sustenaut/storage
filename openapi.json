    "/{tenant}/files": {
      "parameters": [
        {
          "$ref": "#/components/parameters/tenant"
        }
      ],
      "post": {
        "operationId": "uploadFile",
        "summary": "Store one file, named by its content",
        "security": [
          {
            "oidc": []
          },
          {
            "github": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "contentMediaType": "application/octet-stream",
                    "description": "Of a type the tenant takes, checked by extension and first bytes"
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$",
                    "description": "The file's name; the upload's own name when not given"
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "What it is, for a person; longer is cut"
                  },
                  "subject": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "What it is about, such as a card's id, for a listing to find; longer is cut"
                  },
                  "kept": {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ],
                    "description": "Never cleaned: a document that went out. Once kept, always kept"
                  },
                  "for": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Whom an app or service uploads for; ignored from a person's token"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Where it is stored, and what was kept with it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredFile"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
