{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.dns",
      "paths": [
        ".github/workflows/deploy.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.pages",
      "paths": [
        ".github/workflows/deploy.yml",
        "package.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "cloudflare.r2",
      "paths": [
        "wrangler.toml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.actions-oidc",
      "paths": [
        ".github/workflows/mirror.yml",
        "mirror/terraform.sh",
        "mirror/wheels.sh",
        "src/jwt.js"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/workflows/mirror.yml",
        "mirror/wheels.sh",
        "src/storage.js"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        "src/jwt.js"
      ],
      "mode": "advisory"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ],
  "exclude": [
    {
      "path": "tests/**",
      "reason": "Fakes and test data"
    },
    {
      "path": "**/*.test.js",
      "reason": "Fakes and test data"
    }
  ]
}
